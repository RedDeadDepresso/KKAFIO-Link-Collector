{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/RedDeadDepresso/KKAFIO-Link-Collector",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://reddeaddepresso.github.io/kk-author-scraper/indices/lookup.json",
    "https://*.pximg.net/*",
    "https://reddeaddepresso.github.io/*",
    "*://kk.now.cc/*",
    "*://*.kk.now.cc/*",
    "*://web.telegram.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://koikatsucards.com/*",
        "*://*.koikatsucards.com/*"
      ],
      "js": [
        "koikatsu-adblock.js"
      ],
      "css": [
        "koikatsu-adblock.css"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://pawchive.pw/*",
        "*://*.pawchive.pw/*",
        "*://koikatsucards.com/*",
        "*://*.koikatsucards.com/*",
        "*://db.bepis.moe/*",
        "*://mega.nz/*",
        "*://mega.co.nz/*",
        "*://gofile.io/*",
        "*://drive.google.com/*",
        "*://pixeldrain.com/*",
        "*://*.pixeldrain.com/*",
        "*://pixeldrain.net/*",
        "*://*.pixeldrain.net/*",
        "*://pixeldrain.dev/*",
        "*://*.pixeldrain.dev/*",
        "*://catbox.moe/*",
        "*://files.catbox.moe/*",
        "*://1024tera.com/*",
        "*://*.1024tera.com/*",
        "*://terabox.com/*",
        "*://*.terabox.com/*",
        "*://1024terabox.com/*",
        "*://*.1024terabox.com/*",
        "*://teraboxapp.com/*",
        "*://*.teraboxapp.com/*",
        "*://terabox.app/*",
        "*://*.terabox.app/*",
        "*://freeterabox.com/*",
        "*://*.freeterabox.com/*",
        "*://4funbox.com/*",
        "*://*.4funbox.com/*",
        "*://mirrobox.com/*",
        "*://*.mirrobox.com/*",
        "*://momerybox.com/*",
        "*://*.momerybox.com/*",
        "*://nephobox.com/*",
        "*://*.nephobox.com/*",
        "*://tibibox.com/*",
        "*://*.tibibox.com/*",
        "*://gibibox.com/*",
        "*://*.gibibox.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.pixiv.net/*"
      ],
      "js": [
        "i18n.js",
        "kk.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mediafire.com/*",
        "*://*.mediafire.com/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://kknow.cc/*",
        "*://*.kknow.cc/*"
      ],
      "js": [
        "target.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://web.telegram.org/*"
      ],
      "js": [
        "i18n.js",
        "telegram.js",
        "telegram-collect.js"
      ],
      "css": [
        "telegram.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://reddeaddepresso.github.io/kk-authors/*"
      ],
      "js": [
        "authors-site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kkafio-link-collector@RedDeadDepresso.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "default_locale": "en",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pximg_referer",
        "enabled": true,
        "path": "referer-rules.json"
      },
      {
        "id": "kknow_redirect",
        "enabled": true,
        "path": "redirect-rules.json"
      }
    ]
  }
}
